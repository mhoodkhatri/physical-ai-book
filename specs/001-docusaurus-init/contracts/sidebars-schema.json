{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docusaurus Sidebars Configuration",
  "description": "Schema for Physical AI Textbook sidebar structure",
  "type": "object",
  "properties": {
    "tutorialSidebar": {
      "type": "array",
      "description": "Main sidebar configuration",
      "items": {
        "$ref": "#/definitions/SidebarItem"
      }
    }
  },
  "required": ["tutorialSidebar"],
  "definitions": {
    "SidebarItem": {
      "oneOf": [
        {
          "type": "string",
          "description": "Document ID reference"
        },
        {
          "$ref": "#/definitions/CategoryItem"
        },
        {
          "$ref": "#/definitions/AutogeneratedItem"
        }
      ]
    },
    "CategoryItem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "category"
        },
        "label": {
          "type": "string",
          "description": "Display label in sidebar"
        },
        "collapsed": {
          "type": "boolean",
          "default": true
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SidebarItem"
          }
        },
        "link": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["doc", "generated-index"]
            },
            "id": {
              "type": "string"
            }
          }
        }
      },
      "required": ["type", "label", "items"]
    },
    "AutogeneratedItem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "autogenerated"
        },
        "dirName": {
          "type": "string",
          "description": "Directory path relative to docs/"
        }
      },
      "required": ["type", "dirName"]
    }
  }
}
